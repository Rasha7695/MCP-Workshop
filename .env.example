# OpenAI / OpenRouter API Key
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Google Cloud OAuth 2.0 Client Credentials (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional: explicitly set redirect URI if needed (defaults to http://127.0.0.1:8000/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
